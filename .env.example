# Instrumented debug/profile builds using lib/main_automation.dart only.
ANDROID_APP_PATH=
ANDROID_DEVICE_NAME=
ANDROID_UDID=
# Optional; APK metadata normally supplies these.
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
# Leave unset for 5037; this machine's existing ADB server uses 5038.
ANDROID_ADB_SERVER_PORT=5038
IOS_APP_PATH=
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
IOS_UDID=
IOS_BUNDLE_ID=
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/
# true: WDIO owns the server; false: connect to an already running server.
APPIUM_MANAGED=true
# Optional overrides for documented, synthetic seeded personas used by B3.
PRIMARY_EMAIL=
PRIMARY_PASSWORD=
SECONDARY_EMAIL=
SECONDARY_PASSWORD=
