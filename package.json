{
  "name": "wearway-automation-webdriverio",
  "version": "0.1.0",
  "private": true,
  "description": "WearWay cross-platform Flutter mobile QA portfolio",
  "type": "module",
  "engines": { "node": ">=24.0.0", "npm": ">=10" },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:smoke:android": "wdio run ./config/wdio.android.conf.ts --suite smoke",
    "test:smoke:ios": "wdio run ./config/wdio.ios.conf.ts --suite smoke",
    "test:diagnostics:android": "wdio run ./config/wdio.android.conf.ts --suite diagnostics",
    "test:diagnostics:ios": "wdio run ./config/wdio.ios.conf.ts --suite diagnostics",
    "typecheck": "tsc --noEmit",
    "config:check": "tsx scripts/check-config.ts",
    "drivers:list": "appium driver list --installed",
    "report:generate": "allure generate artifacts/allure-results --clean -o artifacts/allure-report",
    "report:open": "allure open artifacts/allure-report"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@wdio/allure-reporter": "10.1.0",
    "@wdio/appium-service": "10.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/config": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "allure-commandline": "2.46.1",
    "appium": "3.9.0",
    "appium-flutter-driver": "3.10.1",
    "appium-flutter-finder": "0.3.0",
    "appium-uiautomator2-driver": "8.7.3",
    "appium-xcuitest-driver": "11.17.7",
    "dotenv": "18.0.9",
    "npm": "11.21.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "webdriverio": "10.1.0"
  }
}
